{
  "name": "server",
  "version": "1.0.0",
  "description": "Quiz Management & Online Assessment Platform — REST API",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node node_modules/nodemon/bin/nodemon.js src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"src/**/*.js\""
  },
  "keywords": [
    "quiz",
    "assessment",
    "express",
    "postgresql"
  ],
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6"
  }
}
