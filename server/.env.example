# Server environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string (Neon/Supabase hosted instance)
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Authentication
# Generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
